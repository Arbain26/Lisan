# Dependencies
node_modules/
backend/node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
*.local

# Environment Variables & Secrets (SANGAT PENTING: JANGAN PERNAH PUSH KE GITHUB)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.env

# SSH Keys, Certificates, & Private Tokens
*.pem
*.key
*.pub
id_rsa*
id_ed25519*
*.pfx
*.p12

# Database Dumps / Backups (Menghindari kebocoran data sensitif)
*.sql.gz
*.sql.tar.gz
*.dump
*.backup
backup.sql
dump.sql

# Uploads & Temporary Media Files
backend/uploads/*
!backend/uploads/.gitkeep
public/uploads/*
backend/scratch/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

