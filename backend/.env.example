# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PILIH SALAH SATU: SUPABASE ATAU MYSQL LOKAL)

# 1. Menggunakan Supabase Connection Pooler (Wajib untuk Vercel / Cloud Serverless)
# Ambil URI dari: Supabase Dashboard -> Project Settings -> Database -> Connection Pooling
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. Menggunakan MySQL Lokal (Fallback jika DATABASE_URL dikosongkan)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_lisan

# Security
JWT_SECRET=lisan_super_secret_jwt_key_2026_change_in_production

# Supabase Storage (Wajib untuk Upload Foto di Vercel / Cloud Hosting)
# Ambil Project URL & anon/service_role key dari: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=lisan-media
